# ⚠️  Este fichero SÍ se sube a git. Nunca pongas valores reales aquí.
#     Los secretos van en .env.local (ignorado por git) y en Vercel.

# ── Base de datos (Neon) ─────────────────────────────────────────────
# Crea un proyecto en https://neon.tech y copia la "Connection string" (pooled).
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST.neon.tech/neondb?sslmode=require"

# ── Better Auth ──────────────────────────────────────────────────────
# Genera el secreto con: openssl rand -base64 32  (o npx @better-auth/cli secret)
BETTER_AUTH_SECRET=""
# URL base de la app. Local: http://localhost:3000
# En Vercel: la URL de producción, p. ej. https://mi-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# ── Google OAuth (login) ─────────────────────────────────────────────
# https://console.cloud.google.com → APIs y servicios → Credenciales → ID de cliente OAuth
# Redirect URI local:      http://localhost:3000/api/auth/callback/google
# Redirect URI producción: https://TU-APP.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Solo estos emails pueden entrar (separados por comas). Vacío = cualquiera con cuenta Google.
ALLOWED_EMAILS=""

# Los usuarios nuevos heredan una copia de la biblioteca de este email, cada uno
# con su propio estado de lectura. Vacío = cada usuario empieza con la biblioteca vacía.
SHARED_LIBRARY_OWNER_EMAIL=""

# ── Google Books API (catálogo) ──────────────────────────────────────
# Opcional pero recomendada (más cuota): API key en Google Cloud con "Books API" habilitada.
GOOGLE_BOOKS_API_KEY=""

# ── OpenAI (recomendador) ────────────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

# ── Cloudinary (fotos de portadas hechas con la cámara) ──────────────
# Cuenta gratuita en https://cloudinary.com → Dashboard → API Keys.
# Sin esto la app funciona igual; solo falla el botón "Hacer una foto".
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
