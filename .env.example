# ── Google OAuth (login) ─────────────────────────────────────────────
# https://console.cloud.google.com → APIs y servicios → Credenciales → ID de cliente OAuth
# Redirect URI local:      http://localhost:3000/api/auth/callback/google
# Redirect URI producción: https://TU-APP.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Solo estos emails pueden entrar (separados por comas). Vacío = cualquiera con cuenta Google.
